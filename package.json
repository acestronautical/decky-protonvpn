{
  "name": "decky-protonvpn",
  "version": "0.1.0",
  "description": "Control Proton VPN connections from Steam Deck Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests && node --test tests/test_signin.mjs tests/test_panel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acestronautical/deck-protonvpn.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "protonvpn",
    "vpn",
    "steam-deck",
    "deck"
  ],
  "author": "acestronautical",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/acestronautical/deck-protonvpn/issues"
  },
  "homepage": "https://github.com/acestronautical/deck-protonvpn#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "react-test-renderer": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
